# Copy to .env (loaded automatically by godotenv) and adjust as needed.
# Values marked [default] already match the app's built-in defaults.

HOST=127.0.0.1
PORT=4000

ENV=development

# Postgres (matches the Nix-managed dev-services setup)
DSN="postgres://postgres:postgres@localhost:5432/receipt_processor?sslmode=disable" # [default]

# Valkey / Redis
REDIS_ADDR=localhost:6379 # [default]
REDIS_PASSWORD=
REDIS_DB=0 # [default]

# Rate limiting / CORS
LIMITER_ENABLED=false
LIMITER_RPS=10 # [default]
LIMITER_BURST=20 # [default]
CORS_TRUSTED_ORIGINS="http://localhost:5173 http://localhost:3000"
